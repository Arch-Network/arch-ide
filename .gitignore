node_modules
.env
dist
build
.DS_Store
backend/temp

# VS Code
.vscode
.vercel

# programs folder in rust-server. The directory itself must be in git so the
# image build can COPY it; user projects inside it stay untracked.
rust-server/programs/*
!rust-server/programs/.gitkeep

# target folder in rust-server
rust-server/target/*

**/target/*

# Terraform
**/.terraform/*
**/*.tfstate
**/*.tfstate.backup
**/.terraform.lock.hcl

# Third-party repositories
solana-playground/

# Cursor local indexing
.cursorindexingignore

# SpecStory (Cursor extension) - local chat/history artifacts
.specstory/